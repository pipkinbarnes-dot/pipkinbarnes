---
// Scroll to draw: the drawing builds stroke by stroke as the visitor scrolls, with
// Pip's line for kids and a note for grown-ups at each step.
// Uses CSS scroll-driven animations (no script). Where they aren't supported, or the
// visitor has asked for reduced motion, it shows the finished drawing and all four steps.
import { Image } from 'astro:assets';
import DrawingSteps from './DrawingSteps.astro';
import { drawAlong } from '../data/drawalong';

const { steps, subject } = drawAlong;

// Lesson graphic: drop a crisp step-by-step image into assets/lesson/ (SVG best, or a large PNG)
// and it replaces the animated drawing. SVGs are served as-is, so line art stays sharp on Retina.
type Mod = { default: ImageMetadata };
const lessons = import.meta.glob<Mod>('/assets/lesson/*.{svg,png,jpg,jpeg,webp}', { eager: true });
const lesson = Object.values(lessons)[0]?.default;

---

<section class="drawalong" aria-labelledby="drawalong-title">
  <div class="pin">
    <div class="copy">
      <h2 id="drawalong-title">Four steps. One {subject.replace(/^an? /, '')}.</h2>
      <ol class="progress" aria-label="Steps and what to draw with">
        {
          steps.map((s, i) => (
            <li style={`--tool:${s.color}`}>
              <span class="visually-hidden">
                Step {i + 1}: {s.tool}
              </span>
            </li>
          ))
        }
      </ol>
      <ol class="notes">
        {
          steps.map((s, i) => (
            <li>
              <p class="notes__pip">
                <span class="pip-tag">Pip</span>
                <span class="visually-hidden">Step {i + 1}: </span>
                {s.pip}
              </p>
              <p class="grown-ups">
                <b>For grown-ups:</b> {s.grownUps}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
    <figure class="sheet lesson">
      {
        lesson ? (
          <Image
            src={lesson}
            alt={`How to draw ${subject} step by step: a lesson from Draw It, Then Color It!`}
            widths={[480, 800, 1200]}
            sizes="(min-width: 60rem) 34rem, 90vw"
            class="lesson__graphic"
          />
        ) : (
          <>
            <ol class="stepnum" aria-hidden="true">
              {steps.map((_, i) => (
                <li>{i + 1}</li>
              ))}
            </ol>
            <div class="sheet__drawing">
              <DrawingSteps
                label={`${subject[0].toUpperCase()}${subject.slice(1)}, drawn in ${steps.length} steps: a circle, the outline, a stem and leaf, then color`}
                stroke={2.4}
              />
            </div>
          </>
        )
      }
    </figure>
  </div>
</section>

<style>
  .drawalong {
    background: var(--paper);
  }
  .drawalong {
    border-top: var(--line);
  }
  .pin {
    display: grid;
    gap: var(--s3);
    padding: var(--s8) var(--gutter);
    max-width: calc(var(--container) + 2 * var(--gutter));
    margin-inline: auto;
  }
  .copy p {
    max-width: 26rem;
  }

  .progress {
    list-style: none;
    margin: 0 0 var(--s3);
    padding: 0;
    display: flex;
    gap: var(--s1);
  }
  .progress li {
    position: relative;
    width: var(--s6);
    height: var(--s2);
    border: var(--line-thin);
    border-radius: 999px;
    background: var(--paper);
    overflow: hidden;
  }
  .progress li::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tool);
    transform-origin: left;
  }

  /* Static: every step listed */
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s2);
    max-width: 26rem;
  }
  .notes p {
    margin: 0;
  }
  .notes__pip {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 2.25rem;
  }
  .grown-ups {
    margin-top: var(--s1) !important;
  }

  /* The lesson card: thick outline and a sticker shadow, like a page from the book */
  .sheet {
    position: relative;
    margin: 0;
    width: min(100%, 28rem);
    aspect-ratio: 1;
    background: var(--paper);
    border: var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--sticker);
    overflow: hidden;
  }
  .lesson :global(.lesson__graphic) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .sheet__drawing {
    position: absolute;
    inset: 10%;
  }
  .sheet :global(.guide) {
    opacity: 0;
  }
  .stepnum {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    top: var(--s2);
    left: var(--s2);
    display: grid;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1;
  }
  .stepnum li {
    grid-area: 1 / 1;
    visibility: hidden;
    display: grid;
    place-items: center;
    width: var(--s6);
    height: var(--s6);
    border: var(--line);
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
  }
  .stepnum li:last-child {
    visibility: visible;
  }

  /* Animated: a tall section with the sheet pinned; scrolling through it draws the page */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .drawalong {
        height: 320vh;
        view-timeline-name: --draw;
      }
      .pin {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100svh;
        align-content: center;
        padding-block: 1.5rem;
      }
      .sheet {
        width: min(100%, 28rem, 50svh);
      }
      .notes {
        gap: 0;
        min-height: 7.5rem;
      }
      .notes li {
        grid-area: 1 / 1;
        opacity: 0;
        animation-name: step-show;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .stepnum li {
        visibility: visible;
        opacity: 0;
        animation-name: step-show;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .notes li:nth-child(1), .stepnum li:nth-child(1) { animation-range: contain 0% contain 19%; }
      .notes li:nth-child(2), .stepnum li:nth-child(2) { animation-range: contain 19% contain 46%; }
      .notes li:nth-child(3), .stepnum li:nth-child(3) { animation-range: contain 46% contain 70%; }
      .notes li:nth-child(4), .stepnum li:nth-child(4) { animation-range: contain 70% contain 100%; animation-name: step-stay; }

      .sheet :global(.g) {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation-name: stroke-draw;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .sheet :global(.s1) { animation-range: contain 0% contain 18%; }
      .sheet :global(.s2) { animation-range: contain 20% contain 45%; }
      .sheet :global(.s3) { animation-range: contain 47% contain 68%; }
      .sheet :global(.fill) {
        opacity: 0;
        animation-name: fade-in;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
        animation-range: contain 72% contain 88%;
      }
      .sheet :global(.guide) {
        opacity: 1;
        animation-name: fade-out;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
        animation-range: contain 70% contain 85%;
      }

      .progress li::after {
        transform: scaleX(0);
        animation-name: grow;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .progress li:nth-child(1)::after { animation-range: contain 0% contain 18%; }
      .progress li:nth-child(2)::after { animation-range: contain 20% contain 45%; }
      .progress li:nth-child(3)::after { animation-range: contain 47% contain 68%; }
      .progress li:nth-child(4)::after { animation-range: contain 72% contain 88%; }
    }
  }

  @keyframes stroke-draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { to { opacity: 1; } }
  @keyframes fade-out { to { opacity: 0; } }
  @keyframes grow { to { transform: scaleX(1); } }
  @keyframes step-show { 0% { opacity: 0; } 8%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes step-stay { 0% { opacity: 0; } 8%, 100% { opacity: 1; } }

  @media (min-width: 60rem) {
    .pin {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 4rem;
      align-items: center;
    }
    h2 {
      font-size: clamp(3rem, 5vw, 4.75rem);
    }
    .sheet {
      width: min(100%, 34rem);
      justify-self: end;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
      .sheet {
        width: min(100%, 34rem, 74svh);
      }
    }
  }
</style>
