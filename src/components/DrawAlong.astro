---
// Scroll to draw: the drawing builds stroke by stroke as the visitor scrolls, with
// Pip's line for kids and a note for grown-ups at each step.
// Uses CSS scroll-driven animations (no script). Where they aren't supported, or the
// visitor has asked for reduced motion, it shows the finished drawing and all four steps.
import DrawingSteps from './DrawingSteps.astro';
import Todo from './Todo.astro';
import { drawAlong } from '../data/drawalong';

const { steps, subject, standIn } = drawAlong;
---

<section class="drawalong" aria-labelledby="drawalong-title">
  <div class="pin">
    <div class="copy">
      <h2 id="drawalong-title">Four steps. One {subject.replace(/^an? /, '')}.</h2>
      {standIn && <p><Todo label="stand-in drawing: replace with a page from the book" /></p>}
      <ol class="progress" aria-label="Steps and what to draw with">
        {
          steps.map((s, i) => (
            <li style={`--tool:${s.colour}`}>
              <span class="visually-hidden">
                Step {i + 1}: {s.tool}
              </span>
            </li>
          ))
        }
      </ol>
      <ol class="notes">
        {
          steps.map((s, i) => (
            <li>
              <p class="notes__pip">
                <span class="pip-tag">Pip</span>
                <span class="visually-hidden">Step {i + 1}: </span>
                {s.pip}
              </p>
              <p class="grown-ups">
                <b>For grown-ups:</b> {s.grownUps}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="sheet">
      <ol class="stepnum" aria-hidden="true">
        {steps.map((_, i) => <li>{i + 1}</li>)}
      </ol>
      <div class="sheet__drawing">
        <DrawingSteps label={`${subject[0].toUpperCase()}${subject.slice(1)}, drawn in ${steps.length} steps`} stroke={2} />
      </div>
    </div>
  </div>
</section>

<style>
  .drawalong {
    background: var(--paper);
  }
  .pin {
    display: grid;
    gap: 1.5rem;
    padding: 4.5rem var(--gutter);
    max-width: 76rem;
    margin-inline: auto;
  }
  .copy p {
    max-width: 26rem;
  }

  .progress {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    gap: 0.4rem;
  }
  .progress li {
    position: relative;
    width: 3rem;
    height: 8px;
    border-radius: 4px;
    background: var(--rule);
    overflow: hidden;
  }
  .progress li::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--tool);
    transform-origin: left;
  }

  /* Static: every step listed */
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    max-width: 26rem;
  }
  .notes p {
    margin: 0;
  }
  .notes__pip {
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1.2;
  }
  .grown-ups {
    margin-top: 0.4rem !important;
  }

  .sheet {
    position: relative;
    width: min(100%, 28rem);
    aspect-ratio: 1;
    border: 1px solid var(--pencil);
  }
  .sheet__drawing {
    position: absolute;
    inset: 10%;
  }
  .sheet :global(.guide) {
    opacity: 0;
  }
  .stepnum {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    top: 0.45rem;
    left: 0.65rem;
    display: grid;
    font-stretch: 68%;
    font-weight: 800;
    font-size: 2.4rem;
    line-height: 1;
  }
  .stepnum li {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .stepnum li:last-child {
    visibility: visible;
  }

  /* Animated: a tall section with the sheet pinned; scrolling through it draws the page */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .drawalong {
        height: 320vh;
        view-timeline-name: --draw;
      }
      .pin {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100svh;
        align-content: center;
        padding-block: 1.5rem;
      }
      .sheet {
        width: min(100%, 28rem, 50svh);
      }
      .notes {
        gap: 0;
        min-height: 7.5rem;
      }
      .notes li {
        grid-area: 1 / 1;
        opacity: 0;
        animation-name: step-show;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .stepnum li {
        visibility: visible;
        opacity: 0;
        animation-name: step-show;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .notes li:nth-child(1), .stepnum li:nth-child(1) { animation-range: contain 0% contain 19%; }
      .notes li:nth-child(2), .stepnum li:nth-child(2) { animation-range: contain 19% contain 46%; }
      .notes li:nth-child(3), .stepnum li:nth-child(3) { animation-range: contain 46% contain 70%; }
      .notes li:nth-child(4), .stepnum li:nth-child(4) { animation-range: contain 70% contain 100%; animation-name: step-stay; }

      .sheet :global(.g) {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation-name: stroke-draw;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .sheet :global(.s1) { animation-range: contain 0% contain 18%; }
      .sheet :global(.s2) { animation-range: contain 20% contain 45%; }
      .sheet :global(.s3) { animation-range: contain 47% contain 68%; }
      .sheet :global(.fill) {
        opacity: 0;
        animation-name: fade-in;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
        animation-range: contain 72% contain 88%;
      }
      .sheet :global(.guide) {
        opacity: 1;
        animation-name: fade-out;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
        animation-range: contain 70% contain 85%;
      }

      .progress li::after {
        transform: scaleX(0);
        animation-name: grow;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --draw;
      }
      .progress li:nth-child(1)::after { animation-range: contain 0% contain 18%; }
      .progress li:nth-child(2)::after { animation-range: contain 20% contain 45%; }
      .progress li:nth-child(3)::after { animation-range: contain 47% contain 68%; }
      .progress li:nth-child(4)::after { animation-range: contain 72% contain 88%; }
    }
  }

  @keyframes stroke-draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { to { opacity: 1; } }
  @keyframes fade-out { to { opacity: 0; } }
  @keyframes grow { to { transform: scaleX(1); } }
  @keyframes step-show { 0% { opacity: 0; } 8%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes step-stay { 0% { opacity: 0; } 8%, 100% { opacity: 1; } }

  @media (min-width: 60rem) {
    .pin {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 4rem;
      align-items: center;
    }
    h2 {
      font-size: clamp(3rem, 5vw, 4.75rem);
    }
    .sheet {
      width: min(100%, 34rem);
      justify-self: end;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 60rem) {
      .sheet {
        width: min(100%, 34rem, 74svh);
      }
    }
  }
</style>
