---
// The hero film: a silent, looping time-lapse of a page being drawn, hosted on this site
// (no YouTube embed). Drop public/video/hero.mp4 (+ optional hero.webm) and
// public/video/hero-poster.jpg in and it's used; until then, the stand-in drawing plays.
// Pip's lines run as captions. A Pause button is always there (moving content needs one).
import fs from 'node:fs';
import path from 'node:path';
import DrawingSteps from './DrawingSteps.astro';
import Art from './Art.astro';
import { drawAlong } from '../data/drawalong';
import { pip } from '../data/art';

const videoDir = path.join(process.cwd(), 'public', 'video');
const has = (f: string) => fs.existsSync(path.join(videoDir, f));
const film = has('hero.mp4')
  ? {
      mp4: '/video/hero.mp4',
      webm: has('hero.webm') ? '/video/hero.webm' : undefined,
      poster: has('hero-poster.jpg') ? '/video/hero-poster.jpg' : undefined,
      // Pip's lines for the real film, timed to it: public/video/hero.vtt
      captions: has('hero.vtt') ? '/video/hero.vtt' : undefined,
    }
  : undefined;
---

<div class="film-col">
  <figure class="film" data-film>
    {
      film ? (
        <video
          class="film__video"
          muted
          loop
          playsinline
          preload="metadata"
          poster={film.poster}
          aria-label={`Film: a page from the book being drawn, step by step`}
          data-autoplay
        >
          {film.webm && <source src={film.webm} type="video/webm" />}
          <source src={film.mp4} type="video/mp4" />
          {film.captions && <track kind="captions" src={film.captions} srclang="en" label="Pip" default />}
        </video>
      ) : (
        <div class="film__sheet">
          <DrawingSteps label={`Film: ${drawAlong.subject} being drawn, step by step`} stroke={2.4} />
        </div>
      )
    }
    {
      !film && (
        <figcaption class="film__captions" aria-hidden="true">
          {drawAlong.steps.map((s) => (
            <span>
              <span class="pip-tag">Pip</span>
              {s.pip}
            </span>
          ))}
        </figcaption>
      )
    }
    <button class="film__toggle" type="button" aria-pressed="false" data-film-toggle>
      <span class="film__toggle-pause">Pause</span><span class="film__toggle-play">Play</span>
      <span class="visually-hidden"> the film</span>
    </button>
  </figure>
  <div class="film__pip">
    <Art image={pip} alt="Pip the fox" missing="Pip" ratio="3 / 4" sizes="(min-width: 60rem) 10rem, 30vw" widths={[160, 240, 320]} eager />
  </div>
</div>

<script>
  const fig = document.querySelector<HTMLElement>('[data-film]');
  const btn = fig?.querySelector<HTMLButtonElement>('[data-film-toggle]');
  const video = fig?.querySelector<HTMLVideoElement>('video[data-autoplay]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  function setPaused(paused: boolean) {
    if (!fig || !btn) return;
    fig.classList.toggle('is-paused', paused);
    btn.setAttribute('aria-pressed', String(paused));
    if (video) paused ? video.pause() : video.play().catch(() => setPaused(true));
  }

  btn?.addEventListener('click', () => setPaused(!fig!.classList.contains('is-paused')));
  // Respect "reduce motion": start paused, on the finished picture or the poster.
  setPaused(reduce.matches);
</script>

<style>
  .film-col {
    position: relative;
    width: min(88%, 30rem);
    margin: 1.75rem auto 0;
  }
  .film {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    background: var(--paper);
    box-shadow: 0 30px 60px -22px rgba(0, 0, 0, 0.5);
  }
  .film__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film__sheet {
    position: absolute;
    inset: 12% 12% 22%;
  }

  /* Captions: dark bar, bottom left, clear of Pip on the right */
  .film__captions {
    position: absolute;
    left: 4%;
    bottom: 4%;
    max-width: 64%;
    display: grid;
    background: rgba(30, 30, 28, 0.88);
    color: #fff;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.3;
    padding: 0.4rem 0.7rem;
    border-radius: 2px;
  }
  .film__captions > span {
    grid-area: 1 / 1;
    visibility: hidden;
  }
  .film__captions > span:last-child {
    visibility: visible;
  }

  .film__toggle {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--pencil);
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid var(--pencil);
    border-radius: 2px;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }
  .film__toggle-play,
  .is-paused .film__toggle-pause {
    display: none;
  }
  .is-paused .film__toggle-play {
    display: inline;
  }
  .film__toggle:focus-visible {
    outline-color: var(--on-mat);
  }

  .film__pip {
    position: absolute;
    right: -4%;
    bottom: -1.75rem;
    width: 30%;
    max-width: 9.5rem;
  }
  .film__pip :global(.art--empty) {
    background: #f6d9c6;
    border: 2px dashed var(--fox);
    border-radius: 45% 45% 10px 10px;
    color: #8a3410;
    font-weight: 700;
  }

  /* The loop: the stand-in drawing and its captions run on one 12-second clock */
  @media (prefers-reduced-motion: no-preference) {
    .film :global(.g) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation-duration: 12s; animation-timing-function: linear; animation-iteration-count: infinite;
    }
    .film :global(.s1) { animation-name: film-s1; }
    .film :global(.s2) { animation-name: film-s2; }
    .film :global(.s3) { animation-name: film-s3; }
    .film :global(.fill) { opacity: 0; animation-name: film-fill; animation-duration: 12s; animation-timing-function: linear; animation-iteration-count: infinite; }
    .film :global(.guide) { animation-name: film-guide; animation-duration: 12s; animation-timing-function: linear; animation-iteration-count: infinite; }
    .film__captions > span { visibility: visible; opacity: 0; animation-duration: 12s; animation-timing-function: steps(1); animation-iteration-count: infinite; }
    .film__captions > span:nth-child(1) { animation-name: cap-1; }
    .film__captions > span:nth-child(2) { animation-name: cap-2; }
    .film__captions > span:nth-child(3) { animation-name: cap-3; }
    .film__captions > span:nth-child(4) { animation-name: cap-4; }
    .is-paused :global(*),
    .is-paused .film__captions > span {
      animation-play-state: paused !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .film :global(.guide) { opacity: 0; }
  }

  @keyframes film-s1 { 0% { stroke-dashoffset: 1; } 12%, 100% { stroke-dashoffset: 0; } }
  @keyframes film-s2 { 0%, 18% { stroke-dashoffset: 1; } 38%, 100% { stroke-dashoffset: 0; } }
  @keyframes film-s3 { 0%, 44% { stroke-dashoffset: 1; } 60%, 100% { stroke-dashoffset: 0; } }
  @keyframes film-fill { 0%, 66% { opacity: 0; } 80%, 94% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes film-guide { 0%, 70% { opacity: 1; } 82%, 100% { opacity: 0; } }
  @keyframes cap-1 { 0% { opacity: 1; } 18%, 100% { opacity: 0; } }
  @keyframes cap-2 { 0% { opacity: 0; } 18% { opacity: 1; } 44%, 100% { opacity: 0; } }
  @keyframes cap-3 { 0% { opacity: 0; } 44% { opacity: 1; } 66%, 100% { opacity: 0; } }
  @keyframes cap-4 { 0% { opacity: 0; } 66% { opacity: 1; } 97%, 100% { opacity: 0; } }

  @media (min-width: 60rem) {
    .film-col {
      margin: 0 0 0 auto;
    }
  }
</style>
