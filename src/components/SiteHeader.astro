---
// Top bar on every page: the name (links home), and the Buy pill.
// Pinned on wider screens so Buy is always one click away; phones use the bottom bar.
import BuyButton from './BuyButton.astro';
import { book } from '../data/book';

const isHome = Astro.url.pathname === '/';
---

<header class="top">
  <div class="wrap top__inner">
    {isHome ? <span class="top__name">{book.author}</span> : <a class="top__name" href="/">{book.author}</a>}
    <div class="top__buy" data-top-buy>
      <BuyButton size="small" showPrice={false} showMissing={false} />
    </div>
    <a class="top__link" href={isHome ? '#buy' : '/#buy'}>Buy the book</a>
  </div>
</header>

<style>
  .top {
    background: var(--sky);
    border-bottom: var(--line);
  }
  .top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    min-height: var(--s8);
  }
  .top__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    text-decoration: none;
  }
  a.top__name:hover {
    text-decoration: underline;
  }
  .top__link {
    font-weight: 800;
    font-size: var(--step--1);
  }
  .top__buy {
    display: none;
  }
  @media (min-width: 60rem) {
    .top {
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .top__buy {
      display: block;
    }
    .top__link {
      display: none;
    }
  }
</style>
