---
// Book + Person structured data (schema.org JSON-LD). Only facts that are filled in
// src/data/book.ts are included; nothing is guessed. Missing ones are listed at build time.
import { getImage } from 'astro:assets';
import { book, socials } from '../data/book';
import { cover, videoThumbs } from '../data/art';
import { videos } from '../data/videos';

const site = Astro.site;
const missing: string[] = [];
const need = <T,>(value: T, label: string) => {
  if (value === '' || value === undefined || (Array.isArray(value) && !value.length)) {
    missing.push(label);
    return undefined;
  }
  return value;
};

const sameAs = socials.filter((s) => s.url).map((s) => s.url);
need(sameAs, 'social profile URLs (sameAs)');

const person = {
  '@type': 'Person',
  '@id': site ? new URL('#author', site).href : undefined,
  name: book.author,
  sameAs: sameAs.length ? sameAs : undefined,
};

const ages = book.ageRange.match(/(\d+)\D+(\d+)/);

// ISBN: 10 or 13 characters with a valid check digit, otherwise left out
function validIsbn(raw: string) {
  const s = raw.replace(/[-\s]/g, '').toUpperCase();
  if (/^\d{13}$/.test(s)) {
    const sum = [...s].reduce((t, d, i) => t + Number(d) * (i % 2 ? 3 : 1), 0);
    return sum % 10 === 0 ? s : undefined;
  }
  if (/^\d{9}[\dX]$/.test(s)) {
    const sum = [...s].reduce((t, d, i) => t + (d === 'X' ? 10 : Number(d)) * (10 - i), 0);
    return sum % 11 === 0 ? s : undefined;
  }
  return undefined;
}
const isbn = book.isbn ? validIsbn(book.isbn) : undefined;
if (book.isbn && !isbn) console.warn(`[pip] "${book.isbn}" isn't a valid ISBN, so it's left out of the structured data.`);

// Date: only YYYY-MM-DD is unambiguous
const published = /^\d{4}-\d{2}-\d{2}$/.test(book.publishedDate) ? book.publishedDate : undefined;
if (book.publishedDate && !published) console.warn(`[pip] Publication date "${book.publishedDate}" must be YYYY-MM-DD, so it's left out.`);
const coverImage = cover && site ? new URL((await getImage({ src: cover, width: 1200, format: 'jpg' })).src, site).href : undefined;
if (!cover) missing.push('cover image');

const offer =
  book.price && book.currency && book.amazonUrl
    ? { '@type': 'Offer', url: book.amazonUrl, price: book.price, priceCurrency: book.currency }
    : undefined;
if (!offer) missing.push('offer (price, currency and Amazon link)');

const bookData = {
  '@type': 'Book',
  '@id': site ? new URL('#book', site).href : undefined,
  name: need(book.title, 'title'),
  alternativeHeadline: book.subtitle || undefined,
  author: person['@id'] ? { '@id': person['@id'] } : { '@type': 'Person', name: book.author },
  isbn: need(isbn ?? '', 'ISBN'),
  bookFormat: 'https://schema.org/Paperback',
  numberOfPages: book.pageCount ? Number.parseInt(book.pageCount, 10) : need('', 'page count'),
  datePublished: need(published ?? '', 'publication date'),
  image: coverImage,
  url: site?.href,
  sameAs: book.amazonUrl ? [book.amazonUrl] : undefined,
  audience: ages
    ? { '@type': 'PeopleAudience', suggestedMinAge: Number(ages[1]), suggestedMaxAge: Number(ages[2]) }
    : need(undefined, 'age range'),
  offers: offer,
};

if (missing.length) console.warn(`[pip] Structured data is missing: ${missing.join(', ')}.`);

// VideoObject for each listed YouTube video that has what Google requires:
// title, description, upload date (YYYY-MM-DD) and a thumbnail.
const isoDuration = (d: string) => {
  const parts = d.split(':').map(Number);
  if (!parts.length || parts.some(Number.isNaN)) return undefined;
  const [h, m, sec] = parts.length === 3 ? parts : [0, ...(parts.length === 2 ? parts : [0, parts[0]])];
  return `PT${h ? `${h}H` : ''}${m ? `${m}M` : ''}${sec ? `${sec}S` : ''}` || undefined;
};
const youtubeId = (u: string) => u.match(/(?:v=|youtu\.be\/|shorts\/)([\w-]{11})/)?.[1];
const videoNodes = [];
for (const v of videos) {
  const thumb = videoThumbs.get(v.id);
  if (!v.title || !v.description || !/^\d{4}-\d{2}-\d{2}$/.test(v.uploadDate) || !thumb || !site) {
    console.warn(`[pip] Video "${v.id}" is left out of the structured data: it needs a title, description, uploadDate and thumbnail.`);
    continue;
  }
  const id = youtubeId(v.url);
  videoNodes.push({
    '@type': 'VideoObject',
    name: v.title,
    description: v.description,
    uploadDate: v.uploadDate,
    duration: isoDuration(v.duration),
    thumbnailUrl: new URL((await getImage({ src: thumb, width: 1280, format: 'jpg' })).src, site).href,
    url: v.url,
    embedUrl: id ? `https://www.youtube.com/embed/${id}` : undefined,
    author: person['@id'] ? { '@id': person['@id'] } : undefined,
  });
}

// A Book without a name is invalid for search engines, so it's only published once the title is in.
const graph = [...(bookData.name ? [bookData] : []), person, ...videoNodes];
if (!bookData.name) console.warn('[pip] Book structured data is left out until the title is set.');

// Escape "<" so nothing in the data can close the script tag.
const json = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={json} />
