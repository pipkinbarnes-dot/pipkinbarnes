---
// Phones: the title and a Buy pill pinned to the bottom of the screen.
// (On wider screens the pinned top bar carries the Buy pill instead.)
// It slides away while another Buy button is already on screen, so there's never two at once.
import BuyButton from './BuyButton.astro';
import { book } from '../data/book';
---

<div class="sticky-buy" data-sticky-buy>
  <span class="sticky-buy__title">{book.title || 'Pip the fox'}</span>
  <BuyButton showPrice={false} showMissing={false} size="small" />
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-sticky-buy]');
  const others = [...document.querySelectorAll('.buy__button')].filter(
    (el) => !el.closest('[data-sticky-buy]') && !el.closest('[data-top-buy]'),
  );
  if (bar && others.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
      bar.classList.toggle('is-hidden', visible.size > 0);
    });
    others.forEach((el) => io.observe(el));
  }
</script>

<style>
  .sticky-buy {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    padding: var(--s1) var(--gutter) calc(var(--s1) + env(safe-area-inset-bottom));
    background: var(--paper);
    border-top: var(--line);
    transition:
      transform 200ms ease,
      visibility 0s linear 0s;
  }
  .sticky-buy__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.25rem;
  }
  .sticky-buy :global(.buy) {
    flex: none;
  }
  .sticky-buy.is-hidden {
    transform: translateY(110%);
    visibility: hidden;
    transition:
      transform 200ms ease,
      visibility 0s linear 200ms;
  }
  @media (min-width: 60rem) {
    .sticky-buy {
      display: none;
    }
  }
</style>
