---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import BuyButton from '../components/BuyButton.astro';
import Todo from '../components/Todo.astro';
import BookSchema from '../components/BookSchema.astro';
import DrawAlong from '../components/DrawAlong.astro';
import VideoGrid from '../components/VideoGrid.astro';
import { book, socials } from '../data/book';
import { cover, samplePages, banner } from '../data/art';

const cap = (s: string) => s.replace(/\b\w/g, (c) => c.toUpperCase());

// "Main title - Series" is shown as two lines
const [mainTitle, series] = book.title.includes(' - ') ? book.title.split(' - ') : [book.title, ''];

// The banner as a CSS background: a small file for phones, a large one for big screens
const bannerSm = banner ? await getImage({ src: banner, width: 960, format: 'webp' }) : undefined;
const bannerLg = banner ? await getImage({ src: banner, width: 1920, format: 'webp' }) : undefined;
const bannerVars = bannerSm && bannerLg ? `--banner-sm: url(${bannerSm.src}); --banner-lg: url(${bannerLg.src});` : '';

// Carousel: the book's pages (assets/pages), animals first
const slides = [...samplePages].sort((a, b) => (a.kind === b.kind ? 0 : a.kind === 'animal' ? -1 : 1));
const alt = (name: string, kind: string) =>
  `How to draw ${/^[aeiou]/i.test(name) ? 'an' : 'a'} ${name} step by step: ${kind === 'animal' ? 'an animal' : 'a food'} drawing lesson and coloring page from Draw It, Then Color It!, a kids drawing book with Pip the fox`;

const lists = [
  { title: 'Animals', names: book.animals.length ? book.animals : slides.filter((p) => p.kind === 'animal').map((p) => p.name) },
  { title: 'Foods', names: book.foods.length ? book.foods : slides.filter((p) => p.kind === 'food').map((p) => p.name) },
];
---

<Base page="home">
  <BookSchema slot="head" />

  <!-- Top bar: pinned on wider screens, with the Buy pill always in reach -->
  <header class="top">
    <div class="wrap top__inner">
      <span class="top__name">{book.author}</span>
      <div class="top__buy" data-top-buy>
        <BuyButton size="small" showPrice={false} showMissing={false} />
      </div>
      <a class="top__link" href="#buy">Buy the book</a>
    </div>
  </header>

  <main>
    <!-- Hero: the book's banner as the background, title and Buy on a card -->
    <section class="hero on-mat" style={bannerVars} aria-labelledby="hero-title">
      <span class="visually-hidden">
        Banner: “Watch them say ‘I drew that!’” next to the book {book.title}, with Pip the fox holding a giant pencil.
      </span>
      <div class="wrap">
        <div class="hero__card card">
          <h1 id="hero-title">
            {mainTitle}
            {series && <span class="visually-hidden"> - </span>}
            {series && <span class="hero__series">{series}</span>}
          </h1>
          <div class="hero__body">
            <p class="hero__lede">
              A step-by-step drawing book and coloring book: kids learn how to draw animals and yummy foods with Pip the fox,
              then color them in.
            </p>
            <BuyButton />
            <p class="hero__facts">
              Paperback, {book.pageCount || <Todo label="page count" />} pages, ages {book.ageRange || <Todo label="age range" />}
            </p>
          </div>
        </div>
      </div>
    </section>

    <DrawAlong />

    <!-- Inside the book: a swipeable carousel of real pages -->
    <section class="section inside" aria-labelledby="inside-title">
      <div class="wrap">
        <div class="inside__head">
          <div>
            <h2 id="inside-title">Inside the book</h2>
            <p class="lede">Every page shows how to draw it, one step at a time, with room to try it and color it in.</p>
          </div>
          {
            slides.length > 1 && (
              <div class="carousel__nav">
                <button class="round-btn" type="button" data-carousel-prev aria-label="Previous page">
                  <span aria-hidden="true">←</span>
                </button>
                <button class="round-btn" type="button" data-carousel-next aria-label="Next page">
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            )
          }
        </div>
      </div>

      {
        slides.length ? (
          <div class="carousel" data-carousel>
            <ul class="carousel__track" tabindex="0" aria-label="Pages from the book. Scroll sideways to see more." data-carousel-track>
              {slides.map((p, i) => (
                <li class="carousel__slide" aria-label={`${i + 1} of ${slides.length}: ${cap(p.name)}`}>
                  <figure class="page card">
                    <Image
                      src={p.image}
                      alt={alt(p.name, p.kind)}
                      widths={[400, 640, 960, 1280]}
                      sizes="(min-width: 60rem) 26rem, 80vw"
                      class="page__img"
                    />
                    <figcaption class="page__caption">
                      <span class="page__name">{cap(p.name)}</span>
                      <span class:list={['chip', `chip--${p.kind}`]}>{p.kind === 'animal' ? 'Animal' : 'Food'}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
            <div class="carousel__dots" role="group" aria-label="Choose a page">
              {slides.map((p, i) => (
                <button type="button" class="dot" data-carousel-dot={i} aria-label={`Show page ${i + 1}: ${cap(p.name)}`} />
              ))}
            </div>
          </div>
        ) : (
          <div class="wrap">
            <p>
              <Todo label="page pictures: assets/pages/animal-<name>.jpg and food-<name>.jpg" />
            </p>
          </div>
        )
      }

      <div class="wrap lists">
        {
          lists.map((l) => (
            <div class="lists__group">
              <h3>{l.title}</h3>
              {l.names.length ? (
                <ul class="chips">
                  {l.names.map((n) => (
                    <li class="chip">{cap(n)}</li>
                  ))}
                </ul>
              ) : (
                <p>
                  <Todo label={`${l.title.toLowerCase()} from content/book.md`} />
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- Watch Pip draw: video cards that open YouTube -->
    <section class="section on-mat watch" aria-labelledby="watch-title" style={bannerVars}>
      <div class="wrap">
        <h2 id="watch-title">Watch Pip draw</h2>
        <p class="lede">Grab a pencil and draw along with Pip. Pause after each step and copy it.</p>
        <p class="grown-ups"><b>For grown-ups:</b> videos open on YouTube, in a new tab.</p>
        <VideoGrid />
        <div class="follow">
          <h3>Follow Pip</h3>
          <ul class="follow__list">
            {
              socials.map((s) => (
                <li>
                  {s.url ? (
                    <a class="pill-link" href={s.url} target="_blank" rel="noopener">
                      {s.channel}
                      <span class="visually-hidden">(opens in a new tab)</span>
                    </a>
                  ) : (
                    <span class="pill-link pill-link--off">
                      {s.channel} <Todo label="link" />
                    </span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Who it's for -->
    <section class="section who" aria-labelledby="who-title">
      <div class="wrap">
        <h2 id="who-title">Made for families and classrooms</h2>
        <div class="who__grid">
          <article class="who__card card">
            <h3>For parents</h3>
            <p>
              Sit down and draw together, or let them get on with it. Each page shows what to draw next, so kids go at their own
              pace and finish with a drawing that's really theirs.
            </p>
          </article>
          <article class="who__card card">
            <h3>For teachers</h3>
            <p>The whole class can draw the same animal at once, one step at a time.</p>
            <a class="text-link" href="/teachers">Teaching with Pip</a>
          </article>
        </div>
      </div>
    </section>

    <!-- Questions -->
    <section class="section faq" aria-labelledby="faq-title">
      <div class="wrap">
        <h2 id="faq-title">Questions</h2>
        <dl class="faq__list">
          <div class="faq__item card">
            <dt>What age is it for?</dt>
            <dd>Kids aged {book.ageRange || <Todo label="age range" />}.</dd>
          </div>
          <div class="faq__item card">
            <dt>How big is the book?</dt>
            <dd>{book.format || <Todo label="format" />}, with {book.pageCount || <Todo label="page count" />} pages.</dd>
          </div>
          <div class="faq__item card">
            <dt>What paper is it printed on?</dt>
            <dd>
              {
                book.paper
                  ? `${book.paper[0].toUpperCase()}${book.paper.slice(1)}${/[.!?]$/.test(book.paper) ? '' : '.'}`
                  : <Todo label="paper" />
              }
            </dd>
          </div>
          <div class="faq__item card">
            <dt>How does the drawing method work?</dt>
            <dd>
              Each animal or food is split into small steps. Kids copy the first step, add the next, and keep going until the
              drawing is finished. Then they color it in. Pip the fox guides them the whole way.
            </dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- Buy -->
    <section class="section buyblock" id="buy" aria-labelledby="buy-title">
      <div class="wrap">
        <div class:list={['buyblock__card', 'card', { 'buyblock__card--cover': cover }]}>
          {
            cover && (
              <div class="buyblock__cover">
                <Art image={cover} alt={`Front cover of ${book.title}`} missing="Cover" ratio="17 / 22" sizes="(min-width: 60rem) 14rem, 9rem" widths={[240, 360, 480]} />
              </div>
            )
          }
          <div>
            <p class="grown-ups"><b>For grown-ups</b></p>
            <h2 id="buy-title" class="buyblock__title">
              {mainTitle || <Todo label="book title" />}
              {series && <span class="visually-hidden"> - </span>}
              {series && <span class="buyblock__series">{series}</span>}
            </h2>
            <p class="buyblock__facts">
              Paperback by {book.author}, {book.pageCount || <Todo label="page count" />} pages, ages {book.ageRange || <Todo label="age range" />}
            </p>
            <BuyButton />
          </div>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  // Carousel: arrows, dots and swipe all drive the same native scroll-snap track
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  const track = root?.querySelector<HTMLElement>('[data-carousel-track]');
  if (root && track) {
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    const go = (i: number) => {
      const n = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: slides[n].offsetLeft - track.offsetLeft - parseFloat(getComputedStyle(track).paddingLeft), behavior: reduce ? 'auto' : 'smooth' });
    };
    const mark = (i: number) => {
      current = i;
      dots.forEach((d, j) => d.setAttribute('aria-current', String(j === i)));
    };
    document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => go(current - 1));
    document.querySelector('[data-carousel-next]')?.addEventListener('click', () => go(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) mark(slides.indexOf(e.target as HTMLElement));
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));
    mark(0);
  }
</script>

<style>
  /* ---------- Top bar ---------- */
  .top {
    background: var(--sky);
    border-bottom: var(--line);
  }
  .top__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    min-height: var(--s8);
  }
  .top__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
  }
  .top__link {
    font-weight: 800;
    font-size: var(--step--1);
  }
  .top__buy {
    display: none;
  }
  @media (min-width: 60rem) {
    /* Wider screens: the bar stays pinned, so Buy is always one click away */
    .top {
      position: sticky;
      top: 0;
      z-index: 20;
    }
    .top__buy {
      display: block;
    }
    .top__link {
      display: none;
    }
  }

  /* ---------- Hero ---------- */
  .hero {
    background-color: var(--sky);
    background-image: var(--banner-sm);
    background-repeat: no-repeat;
    background-position: center top;
    background-size: 100% auto;
    padding: 62vw 0 var(--s6); /* the banner's own shape: 1632 / 2624 */
  }
  .hero__card {
    padding: var(--s3);
  }
  .hero h1 {
    margin-bottom: var(--s2);
  }
  .hero__series {
    display: block;
    margin-top: var(--s1);
    font-size: var(--step-1);
    line-height: 2rem;
    color: var(--ink-soft);
  }
  .hero__lede {
    font-size: var(--step-0);
    color: var(--ink-soft);
    margin-bottom: var(--s3);
  }
  .hero__facts {
    margin: var(--s2) 0 0;
    font-size: var(--step--1);
    line-height: 1.5rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  @media (min-width: 60rem) {
    .hero {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: flex-end;
      /* Short enough that the card (which hangs 80px below) and its Buy button fit on the first screen */
      min-height: min(50vw, calc(100vh - var(--s8) - 7.5rem));
      margin-bottom: var(--s10);
      padding: 0;
      background-image: var(--banner-lg);
      background-size: cover;
      background-position: center;
    }
    .hero .wrap {
      width: 100%;
    }
    /* A wide, short card over the banner's lower left, clear of its headline */
    .hero__card {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 0 var(--s4);
      align-items: start;
      max-width: 46rem;
      padding: var(--s3) var(--s4);
      margin-bottom: calc(-1 * var(--s10)); /* hang over the banner's bottom edge */
    }
    .hero h1 {
      margin: 0;
      font-size: var(--step-4);
    }
  }

  /* ---------- Inside the book: carousel ---------- */
  .inside__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s3);
  }
  .carousel__nav {
    display: none;
    gap: var(--s2);
    margin-bottom: var(--s2);
  }
  @media (min-width: 40rem) {
    .carousel__nav {
      display: flex;
    }
  }
  .round-btn {
    display: grid;
    place-items: center;
    width: var(--s6);
    height: var(--s6);
    border: var(--line);
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    font: 600 var(--step-1) / 1 var(--font-display);
    box-shadow: 0 4px 0 var(--ink);
    cursor: pointer;
  }
  .round-btn:hover {
    background: var(--tangerine);
  }
  .round-btn:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 var(--ink);
  }

  .carousel__track {
    list-style: none;
    margin: var(--s4) 0 0;
    padding: var(--s1) var(--gutter) var(--s3);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    gap: var(--s3);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__track:focus-visible {
    outline-offset: -4px;
  }
  .carousel__slide {
    scroll-snap-align: start;
  }
  .page {
    margin: 0;
    overflow: hidden;
  }
  .page :global(.page__img) {
    width: 100%;
    height: auto;
    border-bottom: var(--line);
  }
  .page__caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s2);
    padding: var(--s2) var(--s3);
  }
  .page__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 2.25rem;
  }
  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: var(--s1);
    margin-top: var(--s1);
  }
  .dot {
    width: var(--s3);
    height: var(--s3);
    padding: 0;
    border: var(--line-thin);
    border-radius: 50%;
    background: var(--paper);
    cursor: pointer;
  }
  .dot[aria-current='true'] {
    background: var(--tangerine);
  }
  @media (min-width: 60rem) {
    .carousel__track {
      grid-auto-columns: calc((min(100vw, var(--container)) - 2 * var(--s3)) / 3);
      padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
      scroll-padding-inline: max(var(--gutter), calc((100vw - var(--container)) / 2));
    }
  }

  /* Chips: the lists of animals and foods */
  .lists {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s3);
    margin-top: var(--s6);
  }
  @media (min-width: 60rem) {
    .lists {
      grid-template-columns: repeat(2, minmax(0, 20rem));
      gap: var(--s6);
    }
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s1);
  }
  .chip {
    display: inline-block;
    padding: 4px var(--s2);
    border: var(--line-thin);
    border-radius: 999px;
    background: var(--paper);
    font-weight: 800;
    font-size: var(--step--1);
    line-height: 1.5rem;
  }
  .chip--animal {
    background: var(--sun);
  }
  .chip--food {
    background: #ffd0c9;
  }

  /* ---------- Watch ---------- */
  .watch {
    border-top: var(--line);
    border-bottom: var(--line);
    background-image:
      linear-gradient(rgba(104, 200, 242, 0.9), rgba(104, 200, 242, 0.9)),
      var(--banner-lg);
    background-size: cover;
    background-position: center;
  }
  .follow {
    margin-top: var(--s8);
  }
  .follow__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s2);
  }
  .pill-link {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    min-height: var(--s6);
    padding: 0 var(--s3);
    border: var(--line);
    border-radius: 999px;
    background: var(--paper);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 4px 0 var(--ink);
  }
  a.pill-link:hover {
    background: var(--sun);
  }

  /* ---------- Who ---------- */
  .who {
    border-top: 0;
  }
  .who__grid {
    display: grid;
    gap: var(--s4);
    margin-top: var(--s4);
  }
  .who__card {
    padding: var(--s4);
  }
  .who__card p {
    margin-bottom: var(--s2);
  }
  .text-link {
    font-weight: 800;
  }
  @media (min-width: 60rem) {
    .who__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Questions ---------- */
  .faq__list {
    display: grid;
    gap: var(--s3);
    margin: var(--s4) 0 0;
  }
  .faq__item {
    padding: var(--s3);
  }
  .faq__item dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 2rem;
  }
  .faq__item dd {
    margin: var(--s1) 0 0;
    color: var(--ink-soft);
    max-width: var(--measure);
  }
  @media (min-width: 60rem) {
    .faq__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Buy ---------- */
  .buyblock__card {
    padding: var(--s4);
    background: var(--sky-soft);
  }
  .buyblock__card--cover {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--s3);
    align-items: end;
  }
  .buyblock .grown-ups {
    margin-bottom: var(--s1);
  }
  .buyblock__title {
    margin-bottom: var(--s1);
  }
  .buyblock__series {
    display: block;
    margin-top: var(--s1);
    font-size: var(--step-1);
    line-height: 2rem;
    color: var(--ink-soft);
  }
  .buyblock__facts {
    font-weight: 700;
    color: var(--ink-soft);
    margin-bottom: var(--s3);
  }
  @media (min-width: 60rem) {
    .buyblock__card {
      padding: var(--s6);
    }
    .buyblock__card--cover {
      grid-template-columns: 14rem minmax(0, 1fr);
      gap: var(--s6);
    }
  }
</style>
