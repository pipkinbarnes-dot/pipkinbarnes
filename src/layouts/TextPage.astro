---
// Simple text pages (Legal notice, Privacy policy): shared header, a title, readable prose on a card.
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { PageKey } from '../data/pages';

interface Props {
  page: PageKey;
  heading: string;
  updated?: string; // YYYY-MM-DD
}
const { page, heading, updated } = Astro.props;
const updatedText = updated
  ? new Date(`${updated}T12:00:00Z`).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })
  : '';
---

<Base page={page}>
  <SiteHeader />
  <main class="text-page">
    <div class="wrap">
      <h1>{heading}</h1>
      {updatedText && <p class="text-page__updated">Last updated: {updatedText}</p>}
      <article class="text-page__body card">
        <slot />
      </article>
      <p class="text-page__back"><a href="/">Back to the home page</a></p>
    </div>
  </main>
</Base>

<style>
  .text-page {
    padding-block: var(--s8) var(--s10);
    background: var(--sky-soft);
    border-bottom: var(--line);
  }
  .text-page__updated {
    font-weight: 700;
    color: var(--ink-soft);
    margin-bottom: var(--s4);
  }
  .text-page__body {
    max-width: 48rem;
    padding: var(--s4);
  }
  .text-page__body :global(h2) {
    font-size: var(--step-2);
    line-height: 2.25rem;
    margin: var(--s5) 0 var(--s2);
  }
  .text-page__body :global(h2:first-child) {
    margin-top: 0;
  }
  .text-page__body :global(p),
  .text-page__body :global(ul) {
    max-width: var(--measure);
    margin: 0 0 var(--s2);
  }
  .text-page__body :global(ul) {
    padding-left: var(--s3);
  }
  .text-page__body :global(li) {
    margin-bottom: var(--s1);
  }
  .text-page__body :global(address) {
    font-style: normal;
  }
  .text-page__body :global(a) {
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .text-page__back {
    margin-top: var(--s4);
    font-weight: 800;
  }
  @media (min-width: 60rem) {
    .text-page__body {
      padding: var(--s6);
    }
  }
</style>
